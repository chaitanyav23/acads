#!/bin/bash

if [ -f .env ]; then
    export $(grep -v '^#' .env | xargs)
fi

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <input_file> <output_file>"
    exit 1
fi

INPUT_FILE="$1"
OUTPUT_FILE="$2"

if [ -z "$PDF_PASSWORD" ]; then
    read -sp "Enter PDF Password: " PDF_PASS
    echo ""
else
    PDF_PASS="$PDF_PASSWORD"
fi

qpdf --password="$PDF_PASS" --decrypt "$INPUT_FILE" "$OUTPUT_FILE"

if [ $? -eq 0 ]; then
    echo "Success: '$OUTPUT_FILE' has been created."
else
    echo "Error: Failed to decrypt the PDF."
fi

